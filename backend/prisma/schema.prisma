generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  orders    Order[]
  vehicles  UserVehicle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  title       String      @unique
  description String
  brand       String
  imageUrl    String      @default("https://via.placeholder.com/800x600?text=AutoPulse+Product")
  price       Float
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  compatibility ProductCompatibility[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model VehicleMake {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  models    VehicleModel[]
  specs     VehicleSpec[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id        Int             @id @default(autoincrement())
  makeId    Int
  make      VehicleMake     @relation(fields: [makeId], references: [id], onDelete: Restrict)
  name      String
  specs     VehicleSpec[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([makeId, name])
  @@index([makeId])
}

model VehicleEngine {
  id        Int           @id @default(autoincrement())
  code      String        @default("")
  name      String
  specs     VehicleSpec[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name, code])
}

model VehicleSpec {
  id             Int                    @id @default(autoincrement())
  makeId         Int
  modelId        Int
  engineId       Int
  yearFrom       Int
  yearTo         Int
  normalizedName String
  make           VehicleMake            @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model          VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  engine         VehicleEngine          @relation(fields: [engineId], references: [id], onDelete: Restrict)
  userVehicles   UserVehicle[]
  compatibility  ProductCompatibility[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([makeId, modelId, yearFrom, yearTo, engineId])
  @@index([modelId, yearFrom, yearTo])
  @@unique([modelId, engineId, yearFrom, yearTo])
}

model UserVehicle {
  id            Int         @id @default(autoincrement())
  userId        Int
  vehicleSpecId Int
  nickname      String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleSpec   VehicleSpec @relation(fields: [vehicleSpecId], references: [id], onDelete: Restrict)

  @@index([userId, isPrimary])
  @@index([vehicleSpecId])
  @@unique([userId, vehicleSpecId])
}

model ProductCompatibility {
  id            Int         @id @default(autoincrement())
  productId     Int
  vehicleSpecId Int
  source        String      @default("UNKNOWN")
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleSpec   VehicleSpec @relation(fields: [vehicleSpecId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleSpecId])
  @@index([vehicleSpecId])
  @@index([productId, vehicleSpecId])
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status     String      @default("PENDING")
  totalPrice Float
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
