{
  "name": "backend",
  "version": "1.0.0",
  "description": "AutoPulse backend MVP",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:docker": "npm run prisma:migrate:deploy && node dist/src/server.js",
    "test": "npm run build && node --test tests/**/*.test.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "import:fitment": "ts-node-dev --transpile-only src/scripts/fitment-import.ts",
    "import:products:demo": "ts-node-dev --transpile-only src/scripts/import-demo-products.ts",
    "import:vehicles:demo": "ts-node-dev --transpile-only src/scripts/import-demo-vehicles.ts",
    "generate:fitment:demo": "ts-node-dev --transpile-only src/scripts/generate-demo-fitment.ts",
    "seed:demo": "npm run import:products:demo && npm run import:vehicles:demo && npm run generate:fitment:demo",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
